{
  "name": "design-system",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "design-system",
      "workspaces": [
        "packages/*",
        "apps/*"
      ]
    },
    "node_modules/@ds/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "node_modules/@ds/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/tokens": {
      "name": "@ds/tokens",
      "version": "0.1.0"
    },
    "packages/ui": {
      "name": "@ds/ui",
      "version": "0.1.0",
      "dependencies": {
        "@ds/tokens": "0.1.0"
      }
    }
  }
}
